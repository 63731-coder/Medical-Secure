# ========================
# GLOBAL & SYSTEM FILES
# ========================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ========================
# FRONTEND (Node/React)
# ========================
node_modules/
build/
dist/
coverage/
.npm
*.log

# ========================
# BACKEND (Python/Django)
# ========================
# Python bytecode (cache)
__pycache__/
*.pyc
*.pyo
*.pyd

# Django Local Database (Don't commit this!)
db.sqlite3
db.sqlite3-journal

# Virtual Environments (where you installed python libs)
venv/
.venv/
env/
.env_bk/

# Django Media (User uploads)
media/
static/

# Security Logs (Sensitive information)
logs/
*.log

# ELK Stack data (Don't commit Elasticsearch indices)
elasticsearch_data/

# ========================
# SECURITY (Environment vars)
# ========================
# .env files are now committed for educational purposes
# In production, NEVER commit .env files!
# .env
# .env.local
# .env.*.local

# ========================
# SSL/TLS CERTIFICATES
# ========================
# Never commit SSL private keys and certificates
certs/*.key
certs/*.crt
certs/*.csr
certs/*.pem
certs/openssl.cnf
# Keep the generation scripts and documentation
!certs/generate-certs.sh
!certs/generate-certs.bat
!certs/.gitignore
!certs/README.md